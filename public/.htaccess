# ====================================================================
# CONFIGURATION APACHE / CPANEL POUR SHIMA FM 95.9 (REACT SPA)
# ====================================================================

# 1. Empêcher l'affichage de l'index du répertoire
Options -Indexes -MultiViews

# 2. Activer le moteur de réécriture d'URL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS si disponible sur le serveur (décommenter si AutoSSL activé)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Relais de l'API stream audio vers le script PHP pour cPanel
  RewriteRule ^api/stream/?$ stream.php [L,QSA]

  # Ne pas réécrire si le fichier, répertoire ou lien symbolique existe
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirection de toutes les routes SPA vers index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 3. Types MIME essentiels pour les modules ES modernes (Vite)
# Résout l'erreur "Failed to load module script: Strict MIME type checking"
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType application/json .json
  AddType audio/mpeg .mp3
</IfModule>

# 4. Autoriser les requêtes CORS et en-têtes de sécurité
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# 5. Compression GZIP / Deflate pour un chargement rapide
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Mise en cache optimisée des ressources statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 0 seconds"
</IfModule>
